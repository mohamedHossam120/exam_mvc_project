@model List<WebAppUsers.Models.User>

@{
    ViewData["Title"] = "Students List";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-10">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h4 class="mb-0">👨‍🎓 Students Management Panel</h4>
            </div>
            <div class="card-body p-4">
                @if (!Model.Any())
                {
                    <div class="alert alert-info text-center mb-0">No registered students found.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Username</th>
                                    <th>Email</th>
                                    <th class="text-center">Status</th>
                                    <th class="text-center">Score</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int index = 1;
                                }
                                @foreach (var student in Model)
                                {
                                    <tr>
                                        <td>@index</td>
                                        <td class="fw-bold">@student.Username</td>
                                        <td>@student.Email</td>
                                        <td class="text-center">
                                            <span class="badge @(student.HasTakenExam ? "bg-success" : "bg-secondary") px-3 py-2">
                                                @(student.HasTakenExam ? "Exam Submitted" : "Not Taken Yet")
                                            </span>
                                        </td>
                                        <td class="text-center fw-bold text-primary fs-5">
                                            @student.ExamScore
                                        </td>
                                    </tr>
                                    index++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>