@model List<WebAppUsers.Models.User>

@{
    ViewData["Title"] = "Students List";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-11">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3">
                <h4 class="mb-0">👨‍🎓 Students Management Panel</h4>
            </div>
            <div class="card-body p-4">
                @if (!Model.Any())
                {
                    <div class="alert alert-info text-center mb-0">No registered students found.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Username</th>
                                    <th>Email</th>
                                    <th class="text-center">Status</th>
                                    <th>Exam Scores per Subject</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int index = 1;
                                }
                                @foreach (var student in Model)
                                {
                                    bool hasTakenAnyExam = !string.IsNullOrEmpty(student.TakenSubjectIds);
                                    int examsCount = hasTakenAnyExam
                                    ? student.TakenSubjectIds.Split(',', StringSplitOptions.RemoveEmptyEntries).Length
                                    : 0;

                                    <tr>
                                        <td>@index</td>
                                        <td class="fw-bold text-secondary">@student.Username</td>
                                        <td>@student.Email</td>
                                        <td class="text-center">
                                            @if (hasTakenAnyExam)
                                            {
                                                <span class="badge bg-success px-3 py-2">
                                                    Examined (@examsCount)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary px-3 py-2">
                                                    Not Taken Yet
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(student.SubjectScores))
                                            {
                                                var scoreEntries = student.SubjectScores.Split(',', StringSplitOptions.RemoveEmptyEntries);

                                                <div class="d-flex flex-wrap gap-2">
                                                    @foreach (var entry in scoreEntries)
                                                    {
                                                        var parts = entry.Split(':');
                                                        if (parts.Length == 2)
                                                        {
                                                            var subId = parts[0];
                                                            var score = parts[1];

                                                            <span class="p-2 rounded bg-light border d-inline-block shadow-sm text-sm">
                                                                📚 <strong>Subject #@subId:</strong>
                                                                <span class="text-primary fw-bold">@score Deg</span>
                                                            </span>
                                                        }
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted fs-7">No scores recorded</span>
                                            }
                                        </td>
                                    </tr>
                                    index++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>