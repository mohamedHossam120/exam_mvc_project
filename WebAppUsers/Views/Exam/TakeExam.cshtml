@model List<WebAppUsers.Models.Question>

@{
    ViewData["Title"] = "Online Exam";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Online Examination</h2>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-danger">Add Question (Admin Panel)</a>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="alert alert-warning text-center">No questions added yet.</div>
        }
        else
        {
            <form asp-action="SubmitExam" method="post" id="examForm">
                @{
                    int count = 1;
                }

                @foreach (var q in Model)
                {
                    <div class="card shadow-sm mb-4 border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="text-primary">Q@(count): @q.QuestionText</h5>

                                @if (User.IsInRole("Admin"))
                                {
                                    <button type="submit"
                                            form="deleteForm_@q.Id"
                                            class="btn btn-outline-danger btn-sm px-3">
                                        Delete
                                    </button>
                                }
                            </div>

                            <hr />
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="answers[@q.Id]" value="A" id="optA_@q.Id" required>
                                <label class="form-check-label" for="optA_@q.Id">@q.OptionA</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="answers[@q.Id]" value="B" id="optB_@q.Id">
                                <label class="form-check-label" for="optB_@q.Id">@q.OptionB</label>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="answers[@q.Id]" value="C" id="optC_@q.Id">
                                <label class="form-check-label" for="optC_@q.Id">@q.OptionC</label>
                            </div>
                        </div>
                    </div>

                    count++;
                }

                <div class="d-grid mb-5">
                    <button type="submit" class="btn btn-success btn-lg">Submit All Answers</button>
                </div>
            </form>

            @if (User.IsInRole("Admin"))
            {
                @foreach (var q in Model)
                {
                    <form asp-action="Delete" asp-route-id="@q.Id" method="post" id="deleteForm_@q.Id" onsubmit="return confirm('Are you sure you want to delete this question?');" style="display:none;"></form>
                }
            }
        }
    </div>
</div>