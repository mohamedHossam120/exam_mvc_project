@{
    ViewData["Title"] = "Exam Result";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow border-0 p-5">
            <h1 class="text-success mb-4">Submission Successful!</h1>
            <div class="alert alert-info h3">
                @ViewBag.ScoreResult
            </div>
            <div class="mt-4">
                <a asp-action="TakeExam" class="btn btn-primary">Back to Exam</a>
            </div>
        </div>
    </div>
</div>